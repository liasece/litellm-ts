// Code added by the build tool in ../../cmd/overlay to a pin-verified copy of
// github.com/router-for-me/CLIProxyAPI/v8 v8.0.57. It is not part of this
// module's build: the .tmpl suffix keeps `go build ./...` from compiling it
// outside package pluginhost.
//
// The injected file contributes two things to the pinned upstream
// internal/pluginhost package:
//
//  1. newDefaultLoader, a composite pluginLoader used by Host.New (one line of
//     host.go is rewritten to call it). Built-in ids open an in-process
//     dispatcher; every other id — and every explicitly supplied dynamic
//     library — keeps using the untouched dynamicLibraryLoader.
//  2. appendBuiltinPluginFiles, called from selectPluginFiles (one small
//     rewrite of platform.go) so a built-in plugin still shows up in plugin
//     discovery, management listings and the plugins.configs.<id> enable
//     switch when no .so exists on disk.
//
// Host callbacks (host.http.do, host.log, host.auth.*, host.model.*,
// host.stream.*) follow the dynamic implementation exactly: the loader
// registers one hostCallbackInstance per plugin load, and the bridge calls
// Host.callFromPlugin with withHostCallbackIdentity, the same context the
// c-shared cliproxyHostCall builds from hostCtx.
package pluginhost

import (
	"context"
	"fmt"
	"strings"
	"sync"

	subbuiltin "github.com/jtllab/litellm-ts/subscriptions/builtin"
)

// builtinPluginPathPrefix marks pluginFile entries that resolve in-process.
const builtinPluginPathPrefix = "builtin://"

// newDefaultLoader wraps the platform dynamic loader with the built-in
// registry check. Host.New calls this instead of defaultPluginLoader.
func newDefaultLoader() pluginLoader {
	return builtinAwareLoader{fallback: defaultPluginLoader()}
}

type builtinAwareLoader struct {
	fallback pluginLoader
}

func (l builtinAwareLoader) Open(file pluginFile, host *Host) (pluginClient, error) {
	if !isBuiltinPluginFile(file) {
		if l.fallback == nil {
			return nil, fmt.Errorf("plugin loader is unavailable")
		}
		return l.fallback.Open(file, host)
	}
	instance := &hostCallbackInstance{}
	host.registerHostCallbackInstance(file.ID, instance)
	hostCall := subbuiltin.HostCall(func(method string, request []byte) ([]byte, error) {
		return host.callFromPlugin(withHostCallbackIdentity(context.Background(), file.ID, instance), method, request)
	})
	dispatcher, ok, errOpen := subbuiltin.Open(file.ID, hostCall)
	if errOpen != nil {
		host.closeHostHTTPCallbackInstance(file.ID, instance)
		return nil, errOpen
	}
	if !ok {
		// The registry changed between discovery and open; fall back to the
		// dynamic loader so an explicit .so drop-in still wins.
		host.closeHostHTTPCallbackInstance(file.ID, instance)
		if l.fallback == nil {
			return nil, fmt.Errorf("plugin %s is not built in and no dynamic loader is available", file.ID)
		}
		return l.fallback.Open(pluginFile{ID: file.ID, Path: strings.TrimPrefix(file.Path, builtinPluginPathPrefix), Version: file.Version}, host)
	}
	return &builtinPluginClient{
		host:       host,
		id:         file.ID,
		instance:   instance,
		dispatcher: dispatcher,
	}, nil
}

// builtinPluginClient is the pluginClient view of an in-process dispatcher.
type builtinPluginClient struct {
	mu         sync.Mutex
	host       *Host
	id         string
	instance   *hostCallbackInstance
	dispatcher subbuiltin.Dispatcher
	closed     bool
}

func (c *builtinPluginClient) Call(ctx context.Context, method string, request []byte) ([]byte, error) {
	if c == nil {
		return nil, fmt.Errorf("builtin plugin client is nil")
	}
	c.mu.Lock()
	dispatcher := c.dispatcher
	closed := c.closed
	c.mu.Unlock()
	if closed || dispatcher == nil {
		return nil, fmt.Errorf("builtin plugin %s is closed", c.id)
	}
	return dispatcher.Call(ctx, method, request)
}

// Shutdown detaches the callback instance and runs the plugin's own
// plugin.shutdown lifecycle, matching dynamicLibraryClient.close.
func (c *builtinPluginClient) Shutdown() {
	if c == nil {
		return
	}
	c.mu.Lock()
	if c.closed {
		c.mu.Unlock()
		return
	}
	c.closed = true
	host := c.host
	id := c.id
	instance := c.instance
	dispatcher := c.dispatcher
	c.host, c.dispatcher = nil, nil
	c.mu.Unlock()

	if host != nil {
		host.closeHostHTTPCallbackInstance(id, instance)
	}
	if dispatcher != nil {
		dispatcher.Shutdown()
	}
}

func (c *builtinPluginClient) callbackInstance() *hostCallbackInstance {
	if c == nil {
		return nil
	}
	return c.instance
}

// appendBuiltinPluginFiles adds one synthetic pluginFile per registered
// built-in plugin that has no dynamic library of the same id. A .so on disk
// always wins: that keeps the documented "build the plugin from source and
// drop in a newer .so" upgrade path, and it is how an operator pins a version
// through plugins.configs.<id>.store.version.
func appendBuiltinPluginFiles(files []pluginFile, desiredVersions ...map[string]string) []pluginFile {
	desired := normalizeDesiredPluginVersions(desiredVersions...)
	selected := make(map[string]bool, len(files))
	for _, file := range files {
		selected[file.ID] = true
	}
	for _, entry := range subbuiltin.Plugins() {
		if version := desired[entry.ID]; version != "" && version != entry.Version {
			continue
		}
		compiled := pluginFile{ID: entry.ID, Path: builtinPluginPathPrefix + entry.ID, Version: entry.Version}
		if selected[entry.ID] {
			continue
		}
		files = append(files, compiled)
	}
	return files
}

func isBuiltinPluginFile(file pluginFile) bool {
	return strings.HasPrefix(file.Path, builtinPluginPathPrefix)
}
