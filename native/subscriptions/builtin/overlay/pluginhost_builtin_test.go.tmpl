package pluginhost

import (
	"testing"

	subbuiltin "github.com/jtllab/litellm-ts/subscriptions/builtin"
)

func builtinTestEntry(t *testing.T, id string) subbuiltin.Entry {
	t.Helper()
	for _, entry := range subbuiltin.Plugins() {
		if entry.ID == id {
			return entry
		}
	}
	t.Fatalf("builtin registry is missing %s", id)
	return subbuiltin.Entry{}
}

// A host with no plugin files on disk must still see the built-in plugins so
// the existing plugins.configs.<id> enable switch, management listing and
// quota surfaces keep working without a release .so.
func TestBuiltinPluginFilesAppendedWhenNoDynamicLibrary(t *testing.T) {
	files := appendBuiltinPluginFiles(nil)
	seen := map[string]pluginFile{}
	for _, file := range files {
		seen[file.ID] = file
	}
	for _, id := range []string{"opencode-go-cliproxyapi", "commandcode-go-cliproxyapi"} {
		entry := builtinTestEntry(t, id)
		file, ok := seen[id]
		if !ok {
			t.Fatalf("built-in %s was not appended", id)
		}
		if !isBuiltinPluginFile(file) {
			t.Fatalf("%s path = %q, want builtin:// prefix", id, file.Path)
		}
		if file.Version != entry.Version {
			t.Fatalf("%s version = %q, want %q", id, file.Version, entry.Version)
		}
	}
}

// An explicit dynamic library for the same id must win, so a source-built .so
// remains the documented upgrade path.
func TestBuiltinPluginFilesPreferDynamicLibrary(t *testing.T) {
	dynamic := pluginFile{ID: "opencode-go-cliproxyapi", Path: "/tmp/plugins/opencode-go-cliproxyapi.so", Version: "0.2.3"}
	files := appendBuiltinPluginFiles([]pluginFile{dynamic})
	for _, file := range files {
		if file.ID == "opencode-go-cliproxyapi" && isBuiltinPluginFile(file) {
			t.Fatalf("built-in %s shadowed the dynamic library %s", file.ID, dynamic.Path)
		}
	}
	if len(files) != 2 {
		t.Fatalf("files = %d, want the dynamic library plus the other built-in", len(files))
	}
}

// The exact compatibility copy shipped alongside an older image must yield to
// the compiled implementation; an operator-replaced library (different hash)
// still wins through TestBuiltinPluginFilesPreferDynamicLibrary.
func TestBuiltinPluginFilesRespectVersionPin(t *testing.T) {
	entry := builtinTestEntry(t, "opencode-go-cliproxyapi")
	files := appendBuiltinPluginFiles(nil, map[string]string{entry.ID: "9.9.9"})
	for _, file := range files {
		if file.ID == entry.ID {
			t.Fatalf("built-in %s selected despite the version pin", entry.ID)
		}
	}
	files = appendBuiltinPluginFiles(nil, map[string]string{entry.ID: entry.Version})
	found := false
	for _, file := range files {
		if file.ID == entry.ID {
			found = true
		}
	}
	if !found {
		t.Fatalf("built-in %s not selected for a matching version pin", entry.ID)
	}
}
